---
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.meta.title, description = site.meta.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const known = (value: string) => (value.startsWith('[') ? undefined : value);
const euros = (price: string) => Number(price.replace(/\D/g, ''));

// Données structurées : les champs encore à compléter ([…]) sont omis.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.meta.description,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  email: known(site.contact.email),
  telephone: known(site.contact.phone),
  areaServed: known(site.territory),
  priceRange: 'À partir de 300 € HT',
  knowsAbout: [
    'Urbanisme réglementaire',
    "Plan local d'urbanisme",
    'Étude de faisabilité',
    'Capacité constructible',
    'Charge foncière',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Études de faisabilité réglementaire',
    itemListElement: site.offers.items.map((offer) => ({
      '@type': 'Offer',
      name: offer.name,
      description: offer.includes.join(' ; '),
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: euros(offer.price),
        priceCurrency: 'EUR',
        valueAddedTaxIncluded: false,
      },
    })),
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4f1ea" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/newsreader-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Les animations ne sont armées que si le visiteur ne demande pas de mouvement réduit.
      // Filet de sécurité : sans script d'animation au bout de 3,5 s, le dessin s'affiche tel quel.
      (function (d, w) {
        var h = d.documentElement;
        h.classList.add('js');
        if (!w.matchMedia || w.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        h.classList.add('motion');
        w.setTimeout(function () {
          if (!w.__gisementLive) h.classList.remove('motion');
        }, 3500);
      })(document, window);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
