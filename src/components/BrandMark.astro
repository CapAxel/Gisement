---
// Marque : une parcelle en axonométrie et son volume constructible.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
    <path d="M16 28.5 27.3 22 16 15.5 4.7 22Z"></path>
    <path d="M10.4 22.2 16 25.4v-9.2l-5.6-3.2Z" fill="currentColor"></path>
    <path d="M16 25.4l5.6-3.2V13L16 16.2Z" fill="var(--paper)"></path>
    <path d="M10.4 13 16 9.8l5.6 3.2L16 16.2Z" fill="var(--green-roof)"></path>
  </g>
</svg>
