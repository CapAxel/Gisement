---
import { site } from '../content/site';
import { fr } from '../lib/format';
import BrandMark from './BrandMark.astro';
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name}, accueil`}>
    <BrandMark class="brand__mark" />
    <span class="brand__name">{site.name}</span>
    <span class="brand__tag">{fr(site.baseline)}</span>
  </a>
  <nav class="site-nav" aria-label="Navigation principale">
    <ul>
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a class="btn header-cta" href={site.headerCta.href}>
    {site.headerCta.label}
    <span class="btn__meta">{fr(site.headerCta.meta)}</span>
  </a>
</header>
