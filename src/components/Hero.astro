---
import { site } from '../content/site';
import { fr, rich } from '../lib/format';
import Plate from './Plate.astro';

const h = site.hero;
---

<section class="hero" id="accueil" aria-labelledby="hero-title">
  <div class="hero__intro">
    <div class="hero__head">
      <p class="overline">
        <span class="overline__sheet">PL {h.sheet.number}</span>
        <span>{fr(h.overline)}</span>
      </p>
      <h1 id="hero-title" set:html={rich(h.title)} />
      <p class="audience">
        <span class="visually-hidden">{fr(h.audience.label)} : </span>
        {
          h.audience.items.map((item, i) => (
            <Fragment>
              <span class="audience__item">{item}</span>
              {i < h.audience.items.length - 1 && (
                <span class="audience__sep" aria-hidden="true">
                  {' · '}
                </span>
              )}
            </Fragment>
          ))
        }
      </p>
    </div>
    <div class="hero__body">
      <p class="hero__lead">{fr(h.lead)}</p>
      <div class="hero__ctas">
        <a class="btn" href={h.primaryCta.href}>
          {fr(h.primaryCta.label)}
          <span class="btn__meta">{fr(h.primaryCta.meta)}</span>
        </a>
        <a class="link-arrow" href={h.secondaryCta.href}>
          {fr(h.secondaryCta.label)}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
  <Plate />
</section>

<script>
  import '../scripts/plate';
</script>
